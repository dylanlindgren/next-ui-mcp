{
  "name": "next-ui-mcp",
  "version": "1.0.1",
  "packageManager": "pnpm@11.5.2",
  "description": "MCP server for building ServiceNow Now/Next Experience UI Framework (@servicenow/ui-core) components — component patterns and now-ui.json manifest sync checking. Unofficial, community-maintained, not affiliated with or endorsed by ServiceNow.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "next-ui-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "guidance",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "pretest": "pnpm run build",
    "test": "node --test dist/lib/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "servicenow",
    "now-ui-framework",
    "next-experience",
    "now-experience",
    "ui-core",
    "seismic"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@servicenow/component-schema-validation": "^2.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
